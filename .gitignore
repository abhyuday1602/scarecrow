# dependencies
node_modules/

# secrets — never commit your API keys
.env
.env.*
!.env.example
.npmrc

# generated run artifacts (screenshots + findings.json) — may hold page data,
# and anything typed during a run (including credentials)
runs/
logs/

# user-dropped upload test files may contain PII/credentials — keep only the README
uploads/*
!uploads/README.md

# local working notes and internal design/audit docs — never published.
# plan/ holds the roadmap and code review, which describe unfixed security issues.
.dev/
docs/
plan/
opencode.json

# build / test output
*.tgz
coverage/
.eslintcache

# misc
*.log
.DS_Store
Thumbs.db
*.swp
*~
.claude/
.vscode/
.idea/
